# Serves the static site and proxies /api and /ws to the server (docs/technical/deployment.md).
#
# Set in /opt/pictiotheme/.env on the VM:
#   SITE_ADDRESS   the hostname, e.g. 152-70-12-114.sslip.io or pictiotheme.com. Caddy gets a
#                  Let's Encrypt certificate for it automatically.
#   TLS_DIRECTIVE  empty for Let's Encrypt. Behind the Cloudflare proxy with a Cloudflare Origin
#                  certificate: `tls /certs/origin.pem /certs/origin.key`.
{
	servers {
		# Cloudflare's ranges (https://www.cloudflare.com/ips/). Only requests from these may set
		# the client IP, so it can't be spoofed by connecting directly (rule F10).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(to_server) {
	reverse_proxy server:3000 {
		# The real client IP, resolved above. The server trusts only Caddy (TRUST_PROXY).
		header_up X-Forwarded-For {client_ip}
	}
}

{$SITE_ADDRESS} {
	{$TLS_DIRECTIVE}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Link previews: a chat app's bot unfurling an invite link gets a page of Open Graph tags whose
	# image is the room's share card (apps/server/src/modules/rooms/share-card.ts). People get the app.
	@preview {
		path_regexp invite ^/r/([A-Za-z0-9-]{1,20})/?$
		header_regexp User-Agent (?i)(discordbot|twitterbot|slackbot|facebookexternalhit|whatsapp|telegrambot|linkedinbot|skypeuripreview|mastodon|embedly|redditbot|iframely|vkshare|bluesky|google-pagerenderer)
	}
	handle @preview {
		rewrite * /api/rooms/{re.invite.1}/embed
		import to_server
	}

	handle /api/* {
		import to_server
	}
	handle /ws {
		import to_server
	}

	handle {
		encode zstd gzip
		root * /srv

		# The old lobby: the home page is the lobby now. Keep in sync with apps/web/src/app-routes.ts.
		redir /play / 301
		redir /play/ / 301

		# App routes are served by the React shell. Keep in sync with apps/web/src/app-routes.ts.
		@app path /r /r/* /decks* /generate* /account*
		rewrite @app /app/index.html

		# Astro's hashed bundles never change.
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
