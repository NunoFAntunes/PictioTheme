---
import { AccountCorner } from '../components/AccountCorner';
import { ProfileCard } from '../components/ProfileCard';
import BaseLayout from '../layouts/BaseLayout.astro';
import { GAMES, SITE_NAME, SITE_TAGLINE } from '../site';
---

<BaseLayout>
  <header class="mx-auto flex max-w-5xl items-center gap-4 px-4 pt-4 sm:px-6">
    <AccountCorner client:only="react" />
  </header>

  <main class="mx-auto flex max-w-5xl flex-col gap-10 px-4 pt-8 pb-16 sm:px-6">
    <div class="flex flex-col gap-2 text-center sm:text-left">
      <h1 class="text-5xl font-black tracking-tight">{SITE_NAME}</h1>
      <p class="text-lg text-muted">{SITE_TAGLINE}</p>
    </div>

    <ProfileCard client:only="react" />

    <section aria-labelledby="games" class="flex flex-col gap-4">
      <h2 id="games" class="text-2xl font-black">Play</h2>
      <ul class="grid gap-5 sm:grid-cols-2">
        {
          GAMES.map((game) => (
            <li>
              <a
                href={game.url}
                class="group flex h-full flex-col gap-4 rounded-3xl border-2 border-ink/10 p-5 shadow-[0_4px_0_rgb(42_33_64/0.15)] transition hover:-translate-y-1 hover:shadow-[0_8px_0_rgb(42_33_64/0.15)] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-ink"
                style={{ background: game.tint }}
              >
                <div class="flex items-center gap-4">
                  <img
                    src={game.icon}
                    alt=""
                    width="64"
                    height="64"
                    class="size-16 transition group-hover:-rotate-6"
                  />
                  <div class="min-w-0">
                    <h3 class="text-2xl font-black">{game.name}</h3>
                    <p class="text-sm font-bold text-ink/60">{game.players}</p>
                  </div>
                </div>
                <p class="flex-1 text-ink/80">{game.tagline}</p>
                <span class="self-start rounded-full bg-ink px-5 py-2 font-extrabold text-white">
                  Play →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
