---
import { PortalSticker } from '../components/profile/PortalSticker';
import { GameSplit } from '../components/split/GameSplit';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_TAGLINE } from '../site';
---

<BaseLayout>
  <h1 class="sr-only">{SITE_NAME}: {SITE_TAGLINE}</h1>
  <!-- You, pinning the top of the line between the games, and riding it as it moves. -->
  <header class="pointer-events-none fixed inset-x-0 top-0 z-10 pt-12">
    <div class="sticker-pin pointer-events-auto">
      <PortalSticker client:only="react">
        <div slot="fallback" class="h-12 w-44" aria-hidden="true"></div>
      </PortalSticker>
    </div>
  </header>
  <main>
    <GameSplit client:load />
  </main>
</BaseLayout>
