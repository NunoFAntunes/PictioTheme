---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'PictioTheme',
  description = 'A multiplayer drawing game where every match has a theme.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
