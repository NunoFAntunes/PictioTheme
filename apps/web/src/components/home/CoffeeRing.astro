---
/*
 * The stain the mug (DeskProps.tsx) left on the corner of the home page's paper. Multiplied
 * into the paper like a real stain. Place inside the paper, before its content.
 */
---

<svg
  aria-hidden="true"
  viewBox="0 0 120 120"
  class="pointer-events-none absolute -bottom-14 -left-12 w-44 rotate-[30deg] overflow-visible mix-blend-multiply"
>
  <g fill="none" stroke="#8a5a3a" stroke-linecap="round">
    <path d="M60 12 A48 48 0 1 1 18 84" stroke-width="5" stroke-opacity="0.4"></path>
    <path d="M14 74 A48 48 0 0 1 52 13" stroke-width="3" stroke-opacity="0.3"></path>
    <path d="M64 17 A43 43 0 0 1 102 52" stroke-width="2" stroke-opacity="0.25"></path>
    <path d="M100 86 q8 6 12 14" stroke-width="4" stroke-opacity="0.3"></path>
  </g>
</svg>
