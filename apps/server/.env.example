# Copy to .env for local development. Matches infra/compose.dev.yaml.
DATABASE_URL=postgres://pictio:pictio@localhost:5433/pictiotheme
PUBLIC_ORIGIN=http://localhost:4321
LOG_LEVEL=debug
SESSION_SECRET=dev-secret-change-me-dev-secret-change-me
# AI deck generation (optional). Get a key at openrouter.ai and set a monthly spending limit on it.
OPENROUTER_API_KEY=
# DECK_MODEL=openai/gpt-6-luna
# DECK_FALLBACK_MODELS=openai/gpt-6-luna-pro
# Set to off for models without structured-output support (e.g. the free stealth/space-bunny-alpha).
# DECK_REQUIRE_PARAMETERS=on
# Lets players generate decks in the app (needs OPENROUTER_API_KEY). On by default; off is the
# kill switch.
# DECK_GENERATION=on
# Limits (defaults shown): per player and per IP in any 24 hours, and a global daily budget.
# GENERATION_PER_PLAYER_PER_DAY=1
# GENERATION_PER_IP_PER_DAY=3
# GENERATION_DAILY_BUDGET_USD=5
# Turn the limits off to generate freely while developing.
GENERATION_LIMITS=off
